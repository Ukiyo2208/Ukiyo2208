# Réglages de Bêta home pour Docker. « installer.sh » crée le fichier .env tout seul (avec une clé au hasard) :
# copiez ce modèle à la main seulement si vous n'utilisez pas le script.  cp .env.example .env
# Ce fichier contient la clé du serveur : ne le partagez pas (il est ignoré par Git).

# Clé maîtresse du serveur (au moins 16 caractères). Les écrans s'associent ensuite par QR code.
BETA_KEY=remplacez-par-une-longue-phrase-secrete

# Port de Bêta home sur le NAS : http://IP-du-NAS:8090
BETA_PORT=8090

# Fuseau horaire (heures des règles, du réveil, de Tempo…)
TZ=Europe/Paris

# Image : « beta-home:local » = construite sur le NAS à partir de ce dossier (par défaut, rien à télécharger).
# Pour l'image publiée sur GitHub (si elle existe pour votre version) : ghcr.io/ukiyo2208/beta-home:latest
BETA_IMAGE=beta-home:local

# Sauvegardes de la nuit conservées
BACKUP_KEEP=30

# Modules du serveur à couper (facultatif), par exemple : BETA_OFF=famille,veille
BETA_OFF=

# Mises à jour depuis Bêta home avec Watchtower (seulement avec l'image publiée sur GitHub)
WATCHTOWER_TOKEN=
