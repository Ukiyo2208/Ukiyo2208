# --- Bêta Tool : réglages ---

# Services optionnels, séparés par des virgules :
#   work  = Bêta Work (suite bureautique ONLYOFFICE, 4 Go de RAM conseillés)
#   vault = Coffre (gestionnaire de mots de passe Vaultwarden)
#   vpn   = VPN WireGuard (wg-easy) pour accéder à la maison depuis l'extérieur
# Exemple sans rien d'optionnel : COMPOSE_PROFILES=
COMPOSE_PROFILES=work

# Secret partagé entre Bêta Tool et ONLYOFFICE : remplace-le par une longue phrase au hasard.
ONLYOFFICE_JWT_SECRET=remplace-moi-par-une-longue-phrase-secrete

# Ancien mot de passe unique du site (vide = rien). Mieux : crée des comptes dans Réglages → Comptes.
APP_PASSWORD=

# Nom affiché pour le stockage : NAS, serveur, PC… (sans NAS, mets par exemple « serveur »)
STORAGE_NAME=NAS

# Dossiers supplémentaires visibles dans Fichiers et la Médiathèque (montés dans docker-compose.yml)
# Format : Nom=/chemin;Autre nom=/autre/chemin
EXTRA_ROOTS=

# Adresse de l'éditeur vue par le navigateur (vide = même adresse que le site, port 8081).
# À renseigner si tu passes par un nom de domaine / HTTPS, ex. https://work.mondomaine.fr
ONLYOFFICE_URL=

# Coffre : adresse HTTPS du coffre (obligatoire pour qu'il fonctionne), ex. https://coffre.mondomaine.fr
VAULT_URL=
# Mets false une fois les comptes de la famille créés
VAULT_SIGNUPS=true
# Jeton de la page d'administration /admin du coffre (vide = page désactivée)
VAULT_ADMIN_TOKEN=

# Modèle de transcription : tiny, base, small (conseillé), medium, large-v3 (plus précis mais bien plus lent)
WHISPER_MODEL=small

# VPN : adresse publique de ta box ou nom DynDNS (ex. maison.synology.me) et mot de passe de wg-easy
VPN_HOST=
VPN_PASSWORD=

# Mails et agendas Outlook / Google (facultatif, aussi réglable dans Réglages → Comptes en ligne ; voir le README)
MS_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
