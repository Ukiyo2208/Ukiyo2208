      "type": "image/png"
    },
    {
      "src": "/brand/icon.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/brand/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
