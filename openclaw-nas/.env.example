# Copie ce fichier en « .env ». Ne le partage jamais.

# Mot de passe de l'interface web d'OpenClaw : génère-le avec  openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Image officielle (GitHub). Pour figer une version : ghcr.io/openclaw/openclaw:2026.9.3 par exemple
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

OPENCLAW_TZ=Europe/Paris

# Dossier partagé des documents à ranger (le dossier _A_TRIER sera créé dedans)
DOCUMENTS=/volume1/Documents

# Jeton de la page de réglage du tri (http://IP_DU_NAS:8802) : l'installateur y met le BETA_TOKEN
TRI_TOKEN=

# Utilisateur propriétaire de tes fichiers sur le NAS (commande : id TON_UTILISATEUR)
PUID=1000
PGID=1000

# Nom du réseau Docker du projet Bêta (sudo docker network ls)
BETA_RESEAU=beta-nas_default
