# Copie ce fichier en « .env » et remplis-le. Ne le partage jamais (il contient tes secrets).

# Mot de passe de Bêta : la tablette l'utilise, et il est demandé hors du réseau de la maison.
# Génère-en un long, par exemple avec : openssl rand -hex 32
BETA_TOKEN=

# À la maison (adresses 192.168.x.x, 10.x.x.x…), la page et l'API ne demandent pas de jeton.
# Mets « non » pour exiger le jeton partout (par exemple si des invités utilisent ton Wi-Fi).
BETA_LOCAL_LIBRE=oui

# Jeton de LECTURE SEULE pour ton site (/v1/nas) : il ne peut rien piloter.
# Génère-le avec : openssl rand -hex 32
BETA_LECTURE_TOKEN=

# Sites autorisés à lire les infos du NAS depuis le navigateur (séparés par des virgules)
# Exemple : BETA_CORS=https://monsite.fr,http://192.168.1.10
BETA_CORS=

# Nom affiché, et disques à surveiller (Nom=chemin dans le conteneur ; /config est sur le volume du NAS)
NAS_NOM=NAS UGREEN
NAS_DISQUES=Volume 1=/config

# Envoi automatique des infos du NAS à ton site (rien à ouvrir sur le NAS) :
# PUBLICATION_URL=https://monsite.fr/api/nas
# PUBLICATION_JETON=un jeton que ton site vérifie
PUBLICATION_URL=
PUBLICATION_JETON=
PUBLICATION_INTERVALLE=60

# Tri des documents (rempli par l'installateur)
# TRI_RANGEMENT : où ranger les documents validés, vu depuis /nas (ex : volume1/Document)
# TRI_HEURES : heures où le modèle prépare les propositions tout seul (0-6 = la nuit, 0-23 = toujours)
TRI_MODELE=qwen3.5:9b
TRI_HEURES=0-6
TRI_RANGEMENT=
TRI_IGNORER=
PUID=1000
PGID=1000

# Notifications du tri (fin d'un « tout traiter », propositions de la nuit, tri bloqué).
# Une ou plusieurs destinations, séparées par des espaces :
#   ha:mobile_app_pixel_8                      appli Home Assistant du téléphone (Outils de développement
#                                              → Actions → cherche « notify.mobile_app_ » pour le nom exact)
#   https://discord.com/api/webhooks/…         salon Discord : Modifier le salon → Intégrations → Webhooks
#   ntfy:https://ntfy.sh/un-nom-long-secret    appli ntfy (gratuite, sans compte)
#   https://monsite.fr/webhook                 tout autre webhook (JSON : titre, message, lien)
NOTIFICATIONS=
# Lien ouvert en touchant la notification (rempli par l'installateur)
TRI_LIEN=

# Home Assistant
# - installé par Bêta sur le NAS : COMPOSE_PROFILES=homeassistant et HA_URL=http://host.docker.internal:8123
# - TON Home Assistant existant : COMPOSE_PROFILES= (vide) et HA_URL=http://IP_DE_TON_HA:8123
COMPOSE_PROFILES=homeassistant
HA_URL=http://host.docker.internal:8123
# Jeton : dans Home Assistant, Profil (en bas à gauche) > Sécurité > Jetons d'accès longue durée > Créer
HA_TOKEN=

# Clé de l'IA web (https://console.anthropic.com), utilisée uniquement pour créer des automatisations.
# Laisse vide pour rester 100 % local (Bêta dira alors qu'il ne peut pas créer d'automatisation).
ANTHROPIC_API_KEY=

# Modèles
# « rapide » : petit modèle du NAS, sert à comprendre les demandes
OLLAMA_MODEL=qwen2.5:3b
# « puissant » (optionnel) : Ollama sur un PC avec carte graphique, pour la discussion
# Exemple : PUISSANT_URL=http://192.168.1.50:11434  et  PUISSANT_MODELE=qwen3.5:27b
PUISSANT_URL=
PUISSANT_MODELE=
WHISPER_MODEL=small-int8
PIPER_VOICE=fr_FR-siwis-medium

TZ=Europe/Paris

# Mots de passe des boîtes mail (référencés dans config/config.yaml).
# Pour Gmail, utilise un « mot de passe d'application », pas ton vrai mot de passe.
MAIL_BASTIEN_PASSWORD=

# Alexa (pont Matter) : port utilisé sur le NAS (à changer seulement s'il est déjà pris)
ALEXA_PORT=5540
